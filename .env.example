# Copy to .env for local development. .env is gitignored.
# Set one local password and use it in both variables below.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://worktruth:<local-password>@localhost:5432/worktruth
PORT=5000
WEB_PORT=5173

# Required to create a demo officer; set your own values before seeding.
SEED_OFFICER_EMAIL=
SEED_OFFICER_NAME=Duty Officer
SEED_OFFICER_PASSWORD=

# Optional initial administrator.
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_NAME=System Administrator
# SEED_ADMIN_PASSWORD=

# Demo projects are seeded by default in local development and never by
# default in production. Set true only for intentional one-time demo seeding.
# SEED_DEMO_DATA=true

# Guest access is read-only and enabled by default. Disable if needed.
# GUEST_DEMO_ENABLED=false
# GUEST_DEMO_EMAIL=guest.demo@example.com
# GUEST_DEMO_NAME=Guest Reviewer

# The migration script detects local non-TLS and remote TLS from DATABASE_URL.
# DATABASE_SSL=require

# Local uploads default to artifacts/api-server/uploads/. On Vercel, uploads
# use a temporary instance directory and are not durable. Do not configure a
# path in the read-only deployment bundle.
# EVIDENCE_UPLOAD_DIR=./uploads
