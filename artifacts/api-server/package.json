{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --env-file-if-exists=../../.env --enable-source-maps ./dist/index.mjs",
    "seed": "tsx --env-file-if-exists=../../.env ./src/seed.ts",
    "reanalyze": "tsx --env-file-if-exists=../../.env ./src/reanalyze.ts",
    "write-demo-assets": "tsx ./src/write-demo-evidence-assets.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "catalog:",
    "exifr": "^7.1.3",
    "express": "^5.2.1",
    "jimp": "^1.6.0",
    "multer": "^2.0.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^1.4.12",
    "@types/node": "catalog:",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0",
    "tsx": "catalog:"
  }
}
